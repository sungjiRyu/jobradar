spring:
  application:
    name: jobradar-backend

  # ===== MySQL =====
  datasource:
    url: jdbc:mysql://localhost:3306/jobradar?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: your_db_username
    password: your_db_password
    driver-class-name: com.mysql.cj.jdbc.Driver

  # ===== JPA =====
  jpa:
    hibernate:
      ddl-auto: create
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        jdbc:
          time_zone: Asia/Seoul

  # ===== Redis =====
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      ssl:
        enabled: ${REDIS_SSL:false}

# ===== CORS =====
app:
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173}

# ===== JWT =====
jwt:
  secret: your-jwt-secret-key-must-be-at-least-256-bits-long-for-security
  access-expiration: 900000     # 15분
  refresh-expiration: 604800000 # 7일

# ===== AI Summary =====
ai:
  base-url: ${AI_BASE_URL:https://api.groq.com/openai/v1/chat/completions}
  api-key: ${GROQ_API_KEY:${AI_API_KEY:}}
  model: ${AI_MODEL:openai/gpt-oss-120b}

# ===== Server =====
server:
  port: 8080
